# Document required variable names only. Never add real values.
APP_ENV=development
APP_NAME=
APP_KEY=
APP_DEBUG=
APP_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=
LOG_LEVEL=debug

# S0: PostgreSQL is required for every local run and every DB test.
# No SQLite substitute. Test suite defaults live in phpunit.xml.
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=
SESSION_ENCRYPT=
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=
SESSION_HTTP_ONLY=
SESSION_SAME_SITE=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=
# S8: development uses the log mailer, tests use the array mailer
# (phpunit.xml). Real SMTP stays BLOCKED (scope §25) — never commit
# credentials here; production SMTP lives in the server secret store.

VITE_APP_NAME="${APP_NAME}"

# S2 PWA/TWA (scope §18). Names only; values live in untracked env files.
# Staging host requires APP_ENV=staging, APP_DEBUG=false,
# SESSION_SECURE_COOKIE=true (see active exec plan). Package ID is a
# PROPOSAL, not owner-approved.
SW_VERSION=
TWA_PACKAGE_NAME=
TWA_SHA256_FINGERPRINT=

# S8 sales switch (scope §25): OFF by default. Turn on only with real
# prices, a real destination, and approved terms/privacy in place.
SALES_ENABLED=false

# S8 staff 2FA (scope §5): enforcement is ON in production by default.
# Set explicitly in non-production only to rehearse the enforced flow.
STAFF_2FA_ENFORCE=
STAFF_2FA_IDLE_MINUTES=

# S8 release metadata (scope §18.2): filled ONLY from a real build.
# All empty until the first release — the download page shows
# «هنوز منتشر نشده» with no file, link, or checksum.
RELEASE_VERSION_NAME=
RELEASE_VERSION_CODE=
RELEASE_DATE=
RELEASE_SIZE_BYTES=
RELEASE_SHA256=
RELEASE_FILE_URL=
